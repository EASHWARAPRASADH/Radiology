            "type": "array",
            "title": "Study Section"
          },
          "clinical_section": {
            "items": {
              "$ref": "#/components/schemas/ReportSentence"
            },
            "type": "array",
            "title": "Clinical Section"
          },
          "technique_quality": {
            "items": {
              "$ref": "#/components/schemas/ReportSentence"
            },
            "type": "array",
            "title": "Technique Quality"
          },
          "findings": {
            "items": {
              "$ref": "#/components/schemas/ReportSentence"
            },
            "type": "array",
            "title": "Findings"
          },
          "impression": {
            "items": {
